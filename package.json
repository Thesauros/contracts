{
  "name": "thesauros-rebalancer",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:arbitrum": "hardhat deploy --network arbitrumOne --tags usdc-vault",
    "predeploy:plasma": "node scripts/predeploy-plasma.js",
    "deploy:plasma": "hardhat deploy --network plasma --tags plasma-usdt0-vault",
    "init:plasma": "hardhat run --network plasma scripts/init-plasma-vault.ts",
    "test:fork:plasma": "forge test --match-contract AaveV3PlasmaProviderTests -vv"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.4",
    "hardhat": "^2.26.0",
    "hardhat-deploy": "^0.12.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0"
  }
}
